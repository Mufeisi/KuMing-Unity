<?xml version="1.0" encoding="utf-8"?>
<!-- OTA 资源下载（8-9-2）：Android 9+ 默认禁止明文 HTTP，UnityWebRequest 拉取 CDN manifest/资源
     会被系统 NetworkSecurityPolicy 直接拒绝（fetch 失败 → resync FAIL）。此文件由 Unity manifest
     合并器合并进最终 APK：仅追加 usesCleartextTraffic=true（游戏 TCP 不受该策略影响，不受影响）。
     生产发布物（HTTPS CDN）可在发布前收紧为 networkSecurityConfig 白名单。 -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application android:usesCleartextTraffic="true" />
</manifest>
